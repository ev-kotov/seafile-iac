[Unit]
Description=Seafile Database service
Requires=traefik-public-network.service
After=traefik-public-network.service

[Container]
ContainerName=seafile-db
Image=docker.io/library/mariadb:12.3.2
EnvironmentFile=%h/projects/seafile-iac/seafile.env
Volume=/srv/seafile-data/db:/var/lib/mysql:Z,U

Network=traefik-public.network

[Install]
WantedBy=default.target